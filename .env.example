# 部署级可选覆盖项。
# 用户模型、分块、OCR、入库、记忆相关配置统一保存在：
#   %LOCALAPPDATA%\ProfileAI\config\user-settings.json
# 不要把真实 .env、API Key 或 Token 提交到 Git。

# 可选：自定义用户数据根目录（默认 %LOCALAPPDATA%\ProfileAI）
# PROFILE_AI_HOME=

APP_HOST=127.0.0.1
APP_PORT=8100

# 本应用网页就绪的最长等待时间（秒）。首次启动受杀毒扫描影响时可适当调大。
APP_READY_TIMEOUT=180

# 启动器会检查 Windows 保留端口，并在不可用时自动选择可用端口。
# 实际端口持久化在 %LOCALAPPDATA%\ProfileAI\config\runtime.json。
LIGHTRAG_URL=http://127.0.0.1:9961
OLLAMA_URL=http://localhost:11434
QDRANT_ENABLED=auto

CORS_ORIGINS=http://127.0.0.1:8100,http://localhost:8100
LOG_LEVEL=INFO
START_SPLASH=true
CLOSE_STOPS_SERVICES=true

# 记忆系统的运行默认值（设置页当前只展示状态，后续阶段会纳入统一设置）。
MEMORY_ENABLED=on
MEMORY_CONTEXT_ENABLED=on
MEMORY_FAST_MEMORY=on
MEMORY_RECALL_ENABLED=off
MEMORY_AUTO_EXTRACT=off
MEMORY_WORKER=off
MEMORY_UPSTREAM_HISTORY=auto
MEMORY_UPSTREAM_MEMORY=off
CHAT_TOPIC_FILTER=off

# 浏览器朗读，不使用服务端 TTS 或语音模型。
