# 本地知识库助手 - 最小运行配置模板
# 复制为 .env 后按需修改。不要把真实 .env、API Key 或 Token 提交到 Git。
APP_HOST=127.0.0.1
APP_PORT=8100

# LightRAG 由用户自行安装或由后续一键脚本安装。9961 避开了 Windows 常见的保留端口段。
LIGHTRAG_URL=http://127.0.0.1:9961
LIGHTRAG_HOME=lightrag
LIGHTRAG_TOP_K=50
LIGHTRAG_CHUNK_TOP_K=30
LIGHTRAG_MAX_ENTITY_TOKENS=8000
LIGHTRAG_MAX_RELATION_TOKENS=10000
LIGHTRAG_MAX_TOTAL_TOKENS=36000
LIGHTRAG_TIMEOUT=180
LIGHTRAG_CONNECT_TIMEOUT=10
LIGHTRAG_RETRIES=2
LIGHTRAG_INCLUDE_REFERENCES=true

OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
QDRANT_ENABLED=auto

MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=.txt,.md,.pdf,.doc,.docx,.csv,.xlsx,.xls,.pptx,.json,.html,.jpg,.jpeg,.png,.webp,.bmp
PARSE_MAX_CHARS=2000000
PARSE_MAX_ASSETS=50
PARSE_MAX_ASSET_MB=20

QUALITY_PROFILE=standard
QUALITY_MIN_CHARS=50
QUALITY_MIN_READABLE_RATIO=0.60
QUALITY_MAX_GARBLED_RATIO=0.05
QUALITY_MAX_REPEAT_RATIO=0.40
QUALITY_MIN_CHARS_PER_PAGE=100
QUALITY_PASS_SCORE=70
QUALITY_MAX_UNOCR_IMAGES=0

INGEST_ASYNC=true
INGEST_CONFIRM=always
PENDING_REVIEW_TTL_HOURS=24

# 默认不扫描任何文件夹。启用后每一份文件仍需人工确认。
INBOX_ENABLED=false
INBOX_POLL_SECONDS=10
INBOX_SETTLE_SECONDS=5
INBOX_CONFIRM=always

# OCR 默认完全关闭，不会上传文件。需要时由用户在设置页显式选择提供方。
OCR_MODE=off
OCR_PROVIDER=none
OCR_IMAGE_OCR=false

# 对话与会话记忆保存在本机 SQLite。长期记忆自动提取默认关闭。
MEMORY_ENABLED=on
MEMORY_CONTEXT_ENABLED=on
MEMORY_FAST_MEMORY=on
MEMORY_RECALL_ENABLED=off
MEMORY_AUTO_EXTRACT=off
MEMORY_WORKER=off
MEMORY_UPSTREAM_HISTORY=auto
MEMORY_UPSTREAM_MEMORY=off
CHAT_TOPIC_FILTER=off

# 朗读仅使用 Edge / 浏览器自带语音，不启用服务端 TTS。

CORS_ORIGINS=http://127.0.0.1:8100,http://localhost:8100
LOG_LEVEL=INFO
START_SPLASH=true
CLOSE_STOPS_SERVICES=true
CHAT_ACCESS_TOKEN=
